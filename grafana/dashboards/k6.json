{
  "uid": "kumostack-k6",
  "title": "K6 — Load Testing",
  "description": "Real-time K6 load test metrics pushed via Prometheus remote-write. Run scenarios from the KumoStack dashboard → Load Testing tab.",
  "tags": ["k6", "load-testing", "kumostack"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [

    { "type": "row", "id": 1, "title": "Test Overview", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 2, "type": "stat", "title": "Active VUs",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [{ "refId": "A", "expr": "vus", "instant": true, "legendFormat": "VUs" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "textMode": "auto", "colorMode": "background",
        "graphMode": "area", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "blue" },
            { "value": 50,   "color": "semi-dark-blue" }
          ]}
        }
      }
    },

    {
      "id": 3, "type": "stat", "title": "Requests / sec",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [{ "refId": "A", "expr": "rate(http_reqs_total[30s])", "instant": true, "legendFormat": "RPS" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "textMode": "auto", "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 100,  "color": "semi-dark-green" }
          ]}
        }
      }
    },

    {
      "id": 4, "type": "stat", "title": "Error Rate",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [{
        "refId": "A",
        "expr": "rate(http_req_failed_total[30s]) / rate(http_reqs_total[30s]) * 100",
        "instant": true, "legendFormat": "Error %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "textMode": "auto", "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 1,    "color": "yellow" },
            { "value": 5,    "color": "red" }
          ]}
        }
      }
    },

    {
      "id": 5, "type": "stat", "title": "p95 Latency",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [{
        "refId": "A",
        "expr": "http_req_duration{quantile=\"0.95\"}",
        "instant": true, "legendFormat": "p95"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "textMode": "auto", "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 500,  "color": "yellow" },
            { "value": 1000, "color": "red" }
          ]}
        }
      }
    },

    {
      "id": 6, "type": "stat", "title": "Total Requests",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [{ "refId": "A", "expr": "http_reqs_total", "instant": true, "legendFormat": "Total" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "textMode": "auto", "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "text" }] } }
      }
    },

    {
      "id": 7, "type": "stat", "title": "Iterations Done",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [{ "refId": "A", "expr": "iterations_total", "instant": true, "legendFormat": "Iterations" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "textMode": "auto", "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "text" }] } }
      }
    },

    { "type": "row", "id": 10, "title": "Throughput & Latency", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 11, "type": "timeseries", "title": "HTTP Requests / sec",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "rate(http_reqs_total[30s])", "legendFormat": "Total RPS" },
        { "refId": "B", "expr": "rate(http_req_failed_total[30s])", "legendFormat": "Failed RPS" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none", "spanNulls": false }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Failed RPS" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] } }
    },

    {
      "id": 12, "type": "timeseries", "title": "Response Time Percentiles",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "http_req_duration{quantile=\"0.5\"}",  "legendFormat": "p50" },
        { "refId": "B", "expr": "http_req_duration{quantile=\"0.95\"}", "legendFormat": "p95" },
        { "refId": "C", "expr": "http_req_duration{quantile=\"0.99\"}", "legendFormat": "p99" },
        { "refId": "D", "expr": "http_req_duration{quantile=\"avg\"}",  "legendFormat": "avg" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 5, "gradientMode": "none", "spanNulls": false }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.lineWidth", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] } }
    },

    {
      "id": 13, "type": "timeseries", "title": "Active Virtual Users",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "vus",     "legendFormat": "Active VUs" },
        { "refId": "B", "expr": "vus_max", "legendFormat": "Max VUs" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Max VUs" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "custom.fillOpacity", "value": 0 }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 14, "type": "timeseries", "title": "Data Sent / Received",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "rate(data_sent_total[30s])",     "legendFormat": "Sent" },
        { "refId": "B", "expr": "rate(data_received_total[30s])", "legendFormat": "Received" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },

    {
      "id": 15, "type": "timeseries", "title": "Error Rate %",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [{
        "refId": "A",
        "expr": "rate(http_req_failed_total[30s]) / rate(http_reqs_total[30s]) * 100",
        "legendFormat": "Error %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 5, "color": "red" }] }
        }
      },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    { "type": "row", "id": 20, "title": "Request Breakdown by Scenario (name tag)", "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 21, "type": "timeseries", "title": "Requests / sec — by Scenario Tag",
      "gridPos": { "x": 0, "y": 21, "w": 14, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [{ "refId": "A", "expr": "rate(http_reqs_total[30s])", "legendFormat": "{{name}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "last"] } }
    },

    {
      "id": 22, "type": "timeseries", "title": "p95 Latency — by Scenario Tag",
      "gridPos": { "x": 14, "y": 21, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [{ "refId": "A", "expr": "http_req_duration{quantile=\"0.95\"}", "legendFormat": "{{name}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "last"] } }
    },

    { "type": "row", "id": 30, "title": "KumoStack Service Metrics (Custom K6 Metrics)", "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 31, "type": "timeseries", "title": "S3 — Operation Latency (p95)",
      "gridPos": { "x": 0, "y": 30, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "kumo_s3_put_duration{quantile=\"0.95\"}", "legendFormat": "PUT p95" },
        { "refId": "B", "expr": "kumo_s3_get_duration{quantile=\"0.95\"}", "legendFormat": "GET p95" },
        { "refId": "C", "expr": "kumo_mixed_s3_duration{quantile=\"0.95\"}", "legendFormat": "Mixed PUT p95" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] } }
    },

    {
      "id": 32, "type": "timeseries", "title": "SQS — Operation Latency (p95)",
      "gridPos": { "x": 8, "y": 30, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "kumo_sqs_send_duration{quantile=\"0.95\"}",    "legendFormat": "Send p95" },
        { "refId": "B", "expr": "kumo_sqs_receive_duration{quantile=\"0.95\"}", "legendFormat": "Receive p95" },
        { "refId": "C", "expr": "kumo_mixed_sqs_duration{quantile=\"0.95\"}",   "legendFormat": "Mixed Send p95" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] } }
    },

    {
      "id": 33, "type": "timeseries", "title": "DynamoDB — Operation Latency (p95)",
      "gridPos": { "x": 16, "y": 30, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "kumo_dynamo_put_duration{quantile=\"0.95\"}", "legendFormat": "PutItem p95" },
        { "refId": "B", "expr": "kumo_dynamo_get_duration{quantile=\"0.95\"}", "legendFormat": "GetItem p95" },
        { "refId": "C", "expr": "kumo_mixed_dynamo_duration{quantile=\"0.95\"}", "legendFormat": "Mixed Put p95" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] } }
    },

    {
      "id": 34, "type": "timeseries", "title": "Lambda — Invoke Latency (p95) + Error Rate",
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "kumo_lambda_invoke_duration{quantile=\"0.95\"}", "legendFormat": "Invoke p95" },
        { "refId": "B", "expr": "kumo_lambda_invoke_duration{quantile=\"0.5\"}",  "legendFormat": "Invoke p50" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] } }
    },

    {
      "id": 35, "type": "timeseries", "title": "Error Counters by Service",
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "increase(kumo_s3_put_errors_total[1m])",        "legendFormat": "S3 PUT errors/min" },
        { "refId": "B", "expr": "increase(kumo_s3_get_errors_total[1m])",        "legendFormat": "S3 GET errors/min" },
        { "refId": "C", "expr": "increase(kumo_sqs_send_errors_total[1m])",      "legendFormat": "SQS Send errors/min" },
        { "refId": "D", "expr": "increase(kumo_sqs_receive_errors_total[1m])",   "legendFormat": "SQS Recv errors/min" },
        { "refId": "E", "expr": "increase(kumo_dynamo_put_errors_total[1m])",    "legendFormat": "DDB Put errors/min" },
        { "refId": "F", "expr": "increase(kumo_dynamo_get_errors_total[1m])",    "legendFormat": "DDB Get errors/min" },
        { "refId": "G", "expr": "increase(kumo_lambda_errors_total[1m])",        "legendFormat": "Lambda errors/min" },
        { "refId": "H", "expr": "increase(kumo_mixed_errors_total[1m])",         "legendFormat": "Mixed errors/min" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "drawStyle": "bars", "barAlignment": 0 }
        }
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "max"] } }
    },

    { "type": "row", "id": 40, "title": "Request Timing Breakdown", "gridPos": { "x": 0, "y": 44, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 41, "type": "timeseries", "title": "Request Phase Breakdown (avg)",
      "description": "How time is split across DNS, connect, TLS, sending, waiting, and receiving.",
      "gridPos": { "x": 0, "y": 45, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfm6ljattwav4f" },
      "targets": [
        { "refId": "A", "expr": "http_req_blocked{quantile=\"avg\"}",        "legendFormat": "Blocked (throttle / queue)" },
        { "refId": "B", "expr": "http_req_connecting{quantile=\"avg\"}",     "legendFormat": "TCP Connect" },
        { "refId": "C", "expr": "http_req_tls_handshaking{quantile=\"avg\"}", "legendFormat": "TLS Handshake" },
        { "refId": "D", "expr": "http_req_sending{quantile=\"avg\"}",        "legendFormat": "Sending" },
        { "refId": "E", "expr": "http_req_waiting{quantile=\"avg\"}",        "legendFormat": "Waiting (TTFB)" },
        { "refId": "F", "expr": "http_req_receiving{quantile=\"avg\"}",      "legendFormat": "Receiving" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal", "group": "A" } }
        }
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "last"] } }
    }

  ]
}
